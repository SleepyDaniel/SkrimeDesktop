{
  "name": "skrime-desktop",
  "version": "1.0.0",
  "description": "Skrime.eu desktop app",
  "author": "SleepyDaniel",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "preview": "vite preview",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "latest",
    "electron-builder": "^25.0.0",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "eu.skrime.desktop",
    "productName": "Skrime Desktop",
    "files": [
      "dist/renderer/**",
      "main.js",
      "preload.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/appLogo.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/assets/appLogo.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/assets/appLogo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
